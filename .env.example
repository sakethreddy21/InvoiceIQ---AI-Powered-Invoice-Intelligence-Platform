# --- Core -----------------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://invoiceiq:invoiceiq@localhost:5433/invoiceiq
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8001
ENVIRONMENT=development
# Signs session and file-preview tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The API refuses to start with the built-in development value when ENVIRONMENT=production.
SECRET_KEY=
UPLOAD_DIR=storage/invoices

# --- OCR for scanned PDFs (runs locally) ------------------------------------------------------
# auto = PaddleOCR if installed (pip install -e '.[ocr]'), else Tesseract (brew install tesseract tesseract-lang); none = off
OCR_PROVIDER=auto
PADDLE_OCR_LANGUAGE=en
OCR_LANGUAGES=deu+eng
# TESSDATA_DIR=/opt/homebrew/share/tessdata
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True

# --- Optional external processing (off by default) ------------------------------------------------
# LLM-assisted extraction only fills fields the rule-based extractors missed. When enabled, invoice
# text is sent to the provider. It never decides compliance.
LLM_PROVIDER=none
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5-5
# EU VIES VAT-ID registration lookups (format/checksum checks always run locally).
VIES_ENABLED=false

# --- Data protection ------------------------------------------------------------------------------
DEFAULT_RETENTION_DAYS=3650
